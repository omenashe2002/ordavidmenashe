---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleBody from '../../components/ArticleBody.astro';
import { getPosts, readingMinutes, relatedPosts, shortTabTitle, tableOfContents } from '../../lib/posts';
import { articleSchema, personSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, related: relatedPosts(post, posts) } }));
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
const minutes = readingMinutes(post.body);
// A contents list is shown for long pieces with at least three sections of the author's own
// (the "Footnotes" heading that is added automatically does not count).
const toc = tableOfContents(headings);
const showToc = minutes >= 6 && toc.filter((item) => item.slug !== 'footnote-label').length >= 3;
---

<BaseLayout
  title={post.data.title}
  headTitle={shortTabTitle(post.data.title)}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
  image={`/og/${post.id}.png`}
  imageAlt={`${post.data.title}, by Or Menashe`}
  structuredData={[articleSchema(post, Astro.site!, `/writing/${post.id}/`, `/og/${post.id}.png`), personSchema(Astro.site!)]}
  wide
>
  <ArticleBody
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    tags={post.data.tags}
    minutes={minutes}
    kicker={post.data.kicker}
    toc={toc}
    showToc={showToc}
    related={related}
    backHref="/writing/"
    backLabel="All writing"
  >
    <Content />
  </ArticleBody>
</BaseLayout>
