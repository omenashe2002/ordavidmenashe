---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tags from '../../components/Tags.astro';
import { getPosts, formatDate, readingMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingMinutes(post.body);
---

<BaseLayout title={post.data.title} description={post.data.description} type="article" publishedTime={post.data.date}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
        <Tags tags={post.data.tags} />
        <span>{minutes} min read</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <p class="more-link"><a href="/writing/">&larr; All writing</a></p>
</BaseLayout>
