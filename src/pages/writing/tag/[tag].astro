---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getPosts, MIN_POSTS_FOR_FILTER, tagsInUse, tagSlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return tagsInUse(posts).map((tag) => ({ params: { tag: tagSlug(tag) }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = await getPosts();
const tags = tagsInUse(posts);
const tagged = posts.filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`Writing on ${tag}`} description={`Articles tagged ${tag} by Or Menashe.`} wide searchable={false}>
  <div class="writing-page">
    <h1>Writing</h1>
    {posts.length >= MIN_POSTS_FOR_FILTER && <TagFilter tags={tags} current={tag} />}
    <PostList posts={tagged} />
    {posts.length < MIN_POSTS_FOR_FILTER && <p class="more-link"><a href="/writing/">&larr; All writing</a></p>}
  </div>
</BaseLayout>
