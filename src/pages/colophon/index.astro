---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// The words come from src/content/pages/colophon.md.
const page = await getEntry('pages', 'colophon');
if (!page) throw new Error('Missing file: src/content/pages/colophon.md');
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="colophon">
    <h1>{page.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>
