---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';

// "https://www.linkedin.com/in/name" is shown as "linkedin.com/in/name".
const linkedinLabel = SITE.linkedin.replace(/^https?:\/\/(www\.)?/, '');
---

<BaseLayout title="Contact" description="How to reach Or Menashe.">
  <h1>Contact</h1>
  <dl class="contact-list">
    <div>
      <dt>Email</dt>
      <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
    </div>
    <div>
      <dt>LinkedIn</dt>
      <dd><a href={SITE.linkedin} rel="noopener">{linkedinLabel}</a></dd>
    </div>
  </dl>
</BaseLayout>
