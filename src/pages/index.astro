---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site';
import { getPosts } from '../lib/posts';

const latest = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <h1>{SITE.tagline}</h1>
  {SITE.intro && <p class="intro">{SITE.intro}</p>}
  {
    latest.length > 0 && (
      <section aria-labelledby="latest-writing">
        <h2 class="section-title" id="latest-writing">Latest writing</h2>
        <PostList posts={latest} level={3} />
        <p class="more-link">
          <a href="/writing/">All writing &rarr;</a>
        </p>
      </section>
    )
  }
</BaseLayout>
