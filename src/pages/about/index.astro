---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Portrait from '../../components/Portrait.astro';
import { SITE } from '../../site';
import { personSchema } from '../../lib/seo';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing file: src/content/pages/about.md');
const { Content } = await render(page);

// "What I'm working on now" is its own small file, so it is easy to refresh: src/content/pages/now.md
const now = await getEntry('pages', 'now');
const Now = now?.body?.trim() ? (await render(now)).Content : undefined;
const linkedinLabel = SITE.linkedin.replace(/^https?:\/\/(www\.)?/, '');
// The short bio is the first paragraph; the rest opens with a button. Add "startShort: false" to about.md to show it all at once.
const startShort = page.data.startShort !== false;
---

<BaseLayout title={page.data.title} description={page.data.description} wide structuredData={[personSchema(Astro.site!)]}>
  <div class="about">
    <h1>{page.data.title}</h1>
    <div class="about-grid">
      <aside class="about-side">
        <figure class="portrait">
          <Portrait sizes="(max-width: 54rem) 15rem, 17rem" />
        </figure>
        <ul class="about-links" aria-label="Get in touch">
          <li><a href={`mailto:${SITE.email}`}>Email</a></li>
          <li><a href={SITE.linkedin} rel="noopener" aria-label={`LinkedIn, ${linkedinLabel}`}>LinkedIn</a></li>
        </ul>
      </aside>
      <div class="about-main" data-bio={startShort ? 'short' : 'full'}>
        <div class="prose" id="bio-text">
          <Content />
        </div>
        {
          startShort && (
            <button class="text-button bio-toggle" type="button" aria-expanded="false" aria-controls="bio-text" data-bio-toggle>
              Read the full bio
            </button>
          )
        }
      </div>
      {
        Now && (
          <section class="now" aria-labelledby="now-title">
            <h2 id="now-title">{now!.data.title}</h2>
            <div class="now-list now-preview">
              <Now />
            </div>
            <p class="now-more">
              <a href="/now/">See the whole list &rarr;</a>
            </p>
            {now!.data.updated && <p class="now-updated">Updated {now!.data.updated}</p>}
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<script>
  // Opens and closes the rest of the bio. Without scripts (or in a browser that cannot tell), the whole bio is simply shown.
  const toggle = document.querySelector<HTMLButtonElement>('[data-bio-toggle]');
  const box = document.querySelector<HTMLElement>('.about-main[data-bio]');
  if (toggle && box) {
    const show = (full: boolean) => {
      box.dataset.bio = full ? 'full' : 'short';
      toggle.textContent = full ? 'Show less' : 'Read the full bio';
      toggle.setAttribute('aria-expanded', String(full));
    };
    toggle.addEventListener('click', () => {
      const full = box.dataset.bio === 'short';
      show(full);
      // Back at the short version, bring the top of the bio into view again.
      if (!full) box.scrollIntoView({ block: 'nearest' });
    });
    // A link (from search, for example) to a part of the bio that is folded away opens the bio first.
    const openForAddress = () => {
      let id = location.hash.slice(1);
      try {
        id = decodeURIComponent(id);
      } catch {
        // an address with a broken % sign: use it as it is
      }
      const target = id ? document.getElementById(id) : null;
      if (target && box.contains(target) && box.dataset.bio === 'short' && target.getClientRects().length === 0) {
        show(true);
        target.scrollIntoView();
      }
    };
    window.addEventListener('hashchange', openForAddress);
    openForAddress();
  }
</script>
