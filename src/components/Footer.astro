---
import { SITE, NAV } from '../site';
import ThemeToggle from './ThemeToggle.astro';
import NewsletterSignup from './NewsletterSignup.astro';

interface Props {
  /** Show the newsletter signup (when a newsletter is set up in src/site.ts). */
  showSignup?: boolean;
}
const { showSignup = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer wrap">
  {
    showSignup && SITE.newsletter.trim() !== '' && (
      <div class="footer-signup">
        <NewsletterSignup id="footer-signup" compact blurb="Each issue of the weekly newsletter by email. Free, and you can unsubscribe at any time." />
      </div>
    )
  }
  <div class="footer-top">
    <div class="footer-brand">
      <a class="site-name" href="/">{SITE.name}</a>
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>
    <div class="footer-columns">
      <nav aria-labelledby="footer-pages">
        <h2 class="footer-heading" id="footer-pages">Pages</h2>
        <ul>
          {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/writing/newsletter/">Weekly newsletter</a></li>
        </ul>
      </nav>
      <section aria-labelledby="footer-elsewhere">
        <h2 class="footer-heading" id="footer-elsewhere">Elsewhere</h2>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>Email</a></li>
          <li><a href={SITE.linkedin} rel="noopener">LinkedIn</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </section>
      <section aria-labelledby="footer-site">
        <h2 class="footer-heading" id="footer-site">Site</h2>
        <ul>
          <li><a href="/colophon/">Colophon</a></li>
        </ul>
        <ThemeToggle />
      </section>
    </div>
  </div>
  <div class="footer-legal">
    <p class="disclaimer">{SITE.disclaimer}</p>
    <p class="copyright">&copy; {year} {SITE.name}</p>
  </div>
</footer>
