---
import { SITE, NAV } from '../site';

const { currentPath } = Astro.props;
// A link counts as "current" when the page address starts with it (so /writing/some-post/ highlights Writing).
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<header class="site-header wrap">
  <a class="site-name" href="/">{SITE.name}</a>
  <nav aria-label="Main">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="search-item">
        <button class="search-open" type="button" data-search-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" d="M10.5 18a7.5 7.5 0 1 1 0-15 7.5 7.5 0 0 1 0 15zM16 16l5 5" /></svg>
          <span class="search-label">Search</span>
          <kbd class="search-key" aria-hidden="true">Ctrl K</kbd>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  import '../scripts/ui';
  import '../scripts/search';
</script>
