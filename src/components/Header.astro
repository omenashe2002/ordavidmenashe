---
import { SITE, NAV } from '../site';

const { currentPath } = Astro.props;
// The name is set as a wordmark: the first name in italics, the surname upright.
const [givenName, ...rest] = SITE.name.split(' ');
// A link counts as "current" when the page address starts with it (so /writing/some-post/ highlights Writing).
const isCurrent = (href: string) => currentPath.startsWith(href);
---

<header class="site-header wrap">
  <a class="site-name" href="/"><i>{givenName}</i> {rest.join(' ')}</a>
  <nav aria-label="Main">
    <ul>
      {
        NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
