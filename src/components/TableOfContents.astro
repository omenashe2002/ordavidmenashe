---
import type { TocItem } from '../lib/posts';

interface Props {
  items: TocItem[];
  /** "rail": a list beside the article on wide screens. "inline": a collapsed list above the article on narrow ones. */
  variant: 'rail' | 'inline';
}
const { items, variant } = Astro.props;
---

{
  variant === 'rail' ? (
    <nav class="toc toc-rail" aria-label="Contents">
      <p class="toc-title">Contents</p>
      <ol>
        {items.map((item) => (
          <li>
            <a href={`#${item.slug}`}>{item.text}</a>
            {item.children.length > 0 && (
              <ol>
                {item.children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  ) : (
    <details class="toc toc-inline">
      <summary>Contents</summary>
      <nav aria-label="Article contents">
        <ol>
          {items.map((item) => (
            <li>
              <a href={`#${item.slug}`}>{item.text}</a>
              {item.children.length > 0 && (
                <ol>
                  {item.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>
    </details>
  )
}

<script>
  // Marks the section being read in the wide-screen list. Without JavaScript the list still works as links.
  import { markCurrent } from '../scripts/toc';

  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-rail a')];
  if (links.length > 0) {
    let waiting = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!waiting) {
          waiting = true;
          requestAnimationFrame(() => {
            waiting = false;
            markCurrent(links);
          });
        }
      },
      { passive: true },
    );
    markCurrent(links);
  }
</script>
