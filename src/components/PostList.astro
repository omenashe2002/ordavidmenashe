---
import Tags from './Tags.astro';
import { formatDate, readingMinutes, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  /** Heading level for each article title: 2 on pages whose main title is an h1, 3 under a section heading. */
  level?: 2 | 3;
}
const { posts, level = 2 } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <p class="post-when">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
          <span>{readingMinutes(post.body)} min read</span>
        </p>
        <div class="post-what">
          <Heading>
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          </Heading>
          <p class="summary">{post.data.description}</p>
          <Tags tags={post.data.tags} />
        </div>
      </li>
    ))
  }
</ol>
