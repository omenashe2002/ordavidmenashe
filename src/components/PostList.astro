---
import Tags from './Tags.astro';
import { formatDate, readingMinutes, STATUS_LABEL, type Post } from '../lib/posts';
import type { Issue } from '../lib/issues';

interface Props {
  posts: (Post | Issue)[];
  /** Heading level for each title: 2 on pages whose main title is an h1, 3 under a section heading. */
  level?: 2 | 3;
  /** Where the entries live: articles are under /writing/, newsletter issues under /writing/newsletter/. */
  basePath?: string;
}
const { posts, level = 2, basePath = '/writing/' } = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
---

<ol class="post-list">
  {
    posts.map((post) => (
      <li>
        <p class="post-when">
          <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(post.data.date)}</time>
          <span>{readingMinutes(post.body)} min read</span>
          {'status' in post.data && post.data.status && <span class="post-status">{STATUS_LABEL[post.data.status]}</span>}
        </p>
        <div class="post-what">
          <Heading>
            <a href={`${basePath}${post.id}/`}>{post.data.title}</a>
          </Heading>
          <p class="summary">{post.data.description}</p>
          {post.data.tags.length > 0 && <Tags tags={post.data.tags} plain={basePath !== '/writing/'} />}
        </div>
      </li>
    ))
  }
</ol>
