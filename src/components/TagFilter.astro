---
import { tagSlug, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  tags: readonly string[];
  /** The topic being viewed, or undefined when viewing all writing. */
  current?: string;
}
const { posts, tags, current } = Astro.props;
const count = (tag: string) => posts.filter((post) => post.data.tags.includes(tag as never)).length;
---

<nav class="tag-filter" aria-label="Filter by topic">
  <ul>
    <li>
      <a href="/writing/" aria-current={current === undefined ? 'page' : undefined}>All <span>{posts.length}</span></a>
    </li>
    {
      tags.map((tag) => (
        <li>
          <a href={`/writing/tag/${tagSlug(tag)}/`} aria-current={current === tag ? 'page' : undefined}>
            {tag} <span>{count(tag)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
