---
import { tagSlug } from '../lib/posts';

interface Props {
  tags: readonly string[];
  /** The topic being viewed, or undefined when viewing all writing. */
  current?: string;
}
const { tags, current } = Astro.props;
---

<nav class="tag-filter" aria-label="Filter by topic">
  <ul>
    <li>
      <a href="/writing/" aria-current={current === undefined ? 'page' : undefined}>All</a>
    </li>
    {
      tags.map((tag) => (
        <li>
          <a href={`/writing/tag/${tagSlug(tag)}/`} aria-current={current === tag ? 'page' : undefined}>
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
